# Configuration du serveur Flow Pomodoro (toutes les variables sont optionnelles).

# Port d'écoute HTTP (défaut : 3000)
PORT=3000

# Fichier SQLite (défaut : ./data/flow.db ; le dossier parent est créé au besoin)
DB_PATH=./data/flow.db

# Dossier des fichiers statiques du build Vite (défaut : react-app/dist)
PUBLIC_DIR=react-app/dist

# Secret de signature des cookies de session (HMAC-SHA256).
# Si absent, un secret aléatoire est généré et conservé dans data/.session-secret.
# SESSION_SECRET=remplacez-par-une-longue-chaine-aleatoire

# Mettre à 1 si le serveur est derrière un reverse proxy HTTPS
# (ajoute l'attribut Secure au cookie de session).
# COOKIE_SECURE=1
